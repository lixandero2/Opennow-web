{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@client/*": ["src/client/*"],
      "@server/*": ["src/server/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/server/**/*.ts", "src/shared/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/server/gfn/auth.ts",
    "src/server/gfn/accountConnections.ts",
    "src/server/gfn/auth/oauthFlow.ts",
    "src/server/gfn/index.ts",
    "src/server/gfn/games.ts"
  ]
}
